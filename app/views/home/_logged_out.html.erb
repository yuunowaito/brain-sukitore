<% content_for :title, "脳を鍛えよう" %>

<%# ===== Hero セクション ===== %>
<section class="relative min-h-[75vh] flex items-center bg-base-200 bg-cover bg-center"
         style="background-image: url('<%= asset_path("hero-desk.jpg") %>');">
  <%# テキスト視認性のためのオーバーレイ（モバイルは全体を淡く、sm以上は右側だけ） %>
  <div class="absolute inset-0 bg-base-100/72 sm:bg-transparent sm:bg-gradient-to-l sm:from-base-100/55 sm:via-base-100/15 sm:to-transparent"></div>

  <div class="relative w-full max-w-6xl mx-auto px-6 py-16">
    <div class="flex flex-col items-center gap-8 text-center sm:ml-auto sm:max-w-xl">
      <%# バッジ %>
      <div class="badge badge-primary badge-outline gap-1 h-auto px-4 py-2 text-xl font-medium bg-base-100/80">
        ✨ 毎日30秒からはじめる脳トレ
      </div>

      <%# メインコピー %>
      <div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-base-content leading-tight mb-4">
          あなたの脳を、<br>
          <span class="text-primary">もっと速く</span>鍛えよう。
        </h1>
        <p class="text-base sm:text-lg text-base-content leading-relaxed">
          ひらがなの計算ゲームで、脳の処理速度をトレーニング。<br class="hidden sm:inline">
          スコアを記録して、成長を実感しよう。
        </p>
      </div>

      <%# CTAボタン %>
      <div class="flex flex-col sm:flex-row gap-3">
        <% if user_signed_in? %>
          <%= link_to "ゲームをはじめる", "#", class: "btn btn-primary btn-lg gap-2" do %>
            ▶ ゲームをはじめる
          <% end %>
        <% else %>
          <%= link_to "無料で登録してはじめる", new_user_registration_path, class: "btn btn-primary btn-lg" %>
          <%= link_to "まずはゲストで試す", "#games", class: "btn btn-outline btn-lg bg-base-100/80" %>
        <% end %>
      </div>

      <%# サブテキスト %>
      <p class="text-lg text-base-content font-medium">登録不要でゲストプレイも可能 · 完全無料</p>
    </div>
  </div>
</section>

<%# ===== 使い方セクション ===== %>
<section id="how-to" class="py-16 px-4 bg-base-100 scroll-mt-20">
  <div class="max-w-4xl mx-auto">
    <div class="badge badge-primary badge-outline mb-3 mx-auto block w-fit">使い方</div>
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-base-content mb-2">
      かんたん3ステップ
    </h2>
    <p class="text-center text-base-content mb-10 text-lg">登録なしでもすぐ遊べます</p>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body items-center text-center gap-3">
          <div class="badge badge-primary badge-lg">1</div>
          <div class="text-4xl">👀</div>
          <h3 class="card-title text-base">ゲームを選ぶ</h3>
          <p class="text-sm text-base-content">
            3種類の脳トレから、好きなものを選んでスタート。
          </p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body items-center text-center gap-3">
          <div class="badge badge-primary badge-lg">2</div>
          <div class="text-4xl">⏱️</div>
          <h3 class="card-title text-base">30秒チャレンジ</h3>
          <p class="text-sm text-base-content">
            制限時間内に、できるだけ多く正解しよう。
          </p>
        </div>
      </div>

      <div class="card bg-base-200 shadow-sm hover:shadow-md transition-shadow">
        <div class="card-body items-center text-center gap-3">
          <div class="badge badge-primary badge-lg">3</div>
          <div class="text-4xl">📈</div>
          <h3 class="card-title text-base">成長をふりかえる</h3>
          <p class="text-sm text-base-content">
            スコアをグラフで記録。過去の自分を超えよう。
          </p>
        </div>
      </div>
    </div>

    <p class="text-center text-lg text-base-content mt-8">
      ※スコアの記録とグラフ表示には無料の会員登録が必要です
    </p>
  </div>
</section>

<%# ===== ゲーム紹介セクション ===== %>
<section id="games" class="py-16 px-4 bg-base-200">
  <div class="max-w-3xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold text-center text-base-content mb-2">
      今すぐ遊べる脳トレ
    </h2>
    <p class="text-center text-base-content mb-10 text-lg">あなたの脳を刺激しよう</p>

    <%# ゲームカード（将来的に game_types からループ） %>
    <%= link_to game_path(@today_game), class: "card bg-base-100 shadow-md hover:shadow-lg transition-shadow cursor-pointer group" do %>
      <div class="card-body flex-row items-center gap-4">
        <div class="w-16 h-16 bg-primary/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-primary/20 transition-colors">
          <span class="text-3xl">🧮</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3 class="card-title text-lg">ひらがな計算</h3>
          <p class="text-sm text-base-content mt-1">
            ひらがなで表された数字の足し算・引き算を解こう。<br>
            30秒で何問解けるか挑戦！
          </p>
          <div class="flex gap-2 mt-2">
            <div class="badge badge-outline badge-sm">初級〜上級</div>
            <div class="badge badge-outline badge-sm">30秒</div>
          </div>
        </div>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/50 group-hover:text-primary transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    <% end %>

    <%# 色じゃんけんカード（仮） %>
<%= link_to game_path(GameType.find_by(name: "color_janken")), class: "card bg-base-100 shadow-md hover:shadow-lg transition-shadow cursor-pointer group mt-4" do %>
  <div class="card-body flex-row items-center gap-4">
    <div class="w-16 h-16 bg-secondary/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-secondary/20 transition-colors">
      <span class="text-3xl">✊</span>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="card-title text-lg">色じゃんけん</h3>
      <p class="text-sm text-base-content mt-1">
        青い手には勝つ手を、赤い手には負ける手を出そう。<br>
        30秒で何問解けるか挑戦！
      </p>
      <div class="flex gap-2 mt-2">
        <div class="badge badge-outline badge-sm">初級〜上級</div>
        <div class="badge badge-outline badge-sm">30秒</div>
      </div>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/50 group-hover:text-secondary transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
<% end %>

<%= link_to game_path(GameType.find_by(name: "color_grid")), class: "card bg-base-100 shadow-md hover:shadow-lg transition-shadow cursor-pointer group mt-4" do %>
  <div class="card-body flex-row items-center gap-4">
    <div class="w-16 h-16 bg-accent/10 rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:bg-accent/20 transition-colors">
      <span class="text-3xl">🟩</span>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="card-title text-lg">色マス記憶</h3>
      <p class="text-sm text-base-content mt-1">
        見本と同じマス配置を再現しよう。<br>
        30秒で何問解けるか挑戦！
      </p>
      <div class="flex gap-2 mt-2">
        <div class="badge badge-outline badge-sm">初級〜上級</div>
        <div class="badge badge-outline badge-sm">30秒</div>
      </div>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-base-content/50 group-hover:text-accent transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
<% end %>
  </div>
</section>

<%# ===== CTA セクション（未ログイン時のみ） ===== %>
<% unless user_signed_in? %>
<section class="relative bg-base-200 bg-cover bg-center py-20 px-4 sm:flex sm:items-center sm:min-h-[28rem] sm:py-24"
         style="background-image: url('<%= asset_path("cta-scene.jpg") %>');">
  <%# 左側の可読性スクリム（モバイルは全体を淡く、sm以上は色ヴェールを外して左→右グラデのみ） %>
  <div class="absolute inset-0 bg-base-100/40 sm:bg-transparent sm:bg-gradient-to-r sm:from-base-100/75 sm:via-base-100/20 sm:to-transparent"></div>

  <div class="relative w-full max-w-6xl mx-auto">
    <div class="w-full text-center sm:max-w-md">
      <h2 class="text-4xl sm:text-5xl font-extrabold text-base-content mb-4">さあ、はじめよう</h2>
      <p class="text-base sm:text-lg text-base-content leading-relaxed mb-8">
        無料で登録してスコアを記録しよう。<br>
        あなたの成長を毎日トラッキング。
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <%= link_to "無料で登録する", new_user_registration_path, class: "btn btn-accent btn-lg" %>
        <%= link_to "ログイン", new_user_session_path, class: "btn btn-outline btn-lg bg-base-100/60" %>
      </div>
    </div>
  </div>
</section>
<% end %>
